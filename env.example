# Sulekha Data Extraction Service - Environment Variables
# Copy this file to .env and fill in the values
# Command: cp env.example .env

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=postgresql+psycopg://sulekha:sulekha@localhost:5432/sulekha

# =============================================================================
# Redis Configuration (Celery Broker)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Storage Configuration
# =============================================================================
# Storage backend: 'gcs' for Google Cloud Storage, 's3' for S3/Minio
STORAGE_BACKEND=gcs

# Google Cloud Storage (production)
GCS_BUCKET_NAME=sulekha-pdfs
GCS_PROJECT_ID=your-gcp-project-id
# Path to service account JSON key file (optional if using default credentials)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# S3/Minio (development) - use with STORAGE_BACKEND=s3
S3_BUCKET_NAME=sulekha-pdfs
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# =============================================================================
# Scraper Configuration
# =============================================================================
# Random delay range between requests (seconds)
SCRAPER_DELAY_MIN=0.5
SCRAPER_DELAY_MAX=1.5
# Request timeout in seconds
SCRAPER_REQUEST_TIMEOUT=60
# Maximum retries for failed requests
SCRAPER_MAX_RETRIES=8
# Maximum concurrent workers
SCRAPER_MAX_WORKERS=3

# =============================================================================
# Rate Limiting Configuration
# =============================================================================
# Enable global rate limiting across all workers
RATE_LIMIT_ENABLED=true
# Maximum concurrent HTTP requests allowed globally (across all workers)
RATE_LIMIT_MAX_CONCURRENT=5

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# Celery Configuration
# =============================================================================
CELERY_WORKER_CONCURRENCY=3

# =============================================================================
# OPTIONAL: Gemini API Key (for PDF content extraction - future feature)
# =============================================================================
# GEMINI_API_KEY=your-gemini-api-key-here

# =============================================================================
# SAKARMA Scraper (sister scraper for meeting.lsgkerala.gov.in)
# =============================================================================
# All SAKARMA settings are SAKARMA_*-prefixed so they coexist with sulekha's.
# Same Postgres database (separate `sakarma` schema), separate GCS bucket.

# Database (same DSN as sulekha; sakarma tables live in 'sakarma' schema)
SAKARMA_DATABASE_URL=postgresql+psycopg://sulekha:sulekha@localhost:5432/sulekha

# Redis (Celery broker; same instance, same DB index works fine)
SAKARMA_REDIS_URL=redis://localhost:6379/0

# Storage — DEDICATED bucket for SAKARMA (NOT sulekha-pdfs)
SAKARMA_STORAGE_BACKEND=gcs
SAKARMA_GCS_BUCKET_NAME=sakarma-meetings
SAKARMA_GCS_PROJECT_ID=your-gcp-project-id

# Local dev / tests
SAKARMA_S3_BUCKET_NAME=sakarma-test
SAKARMA_S3_ENDPOINT_URL=http://localhost:9000
SAKARMA_S3_ACCESS_KEY=minioadmin
SAKARMA_S3_SECRET_KEY=minioadmin

# Scraper
SAKARMA_SCRAPER_BASE_URL=https://meeting.lsgkerala.gov.in
SAKARMA_SCRAPER_DELAY_MIN=0.5
SAKARMA_SCRAPER_DELAY_MAX=1.5
SAKARMA_SCRAPER_REQUEST_TIMEOUT=60
SAKARMA_SCRAPER_MAX_RETRIES=8

# Rate limiting (sakarma keys are namespaced under sakarma:* in Redis)
SAKARMA_RATE_LIMIT_ENABLED=true
SAKARMA_RATE_LIMIT_MAX_CONCURRENT=4

# Celery
SAKARMA_CELERY_WORKER_CONCURRENCY=4

# Logging
SAKARMA_LOG_LEVEL=INFO
SAKARMA_LOG_FORMAT=json
